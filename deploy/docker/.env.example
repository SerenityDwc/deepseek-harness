# Copy to .env and fill in. Do not commit .env.

# Browser trust fence: host[:port] the browser will send as Host, comma-separated.
# Public access 403s on /api until this matches. Example: TRUSTED_HOSTS=192.168.1.10:3080
TRUSTED_HOSTS=

PORT=3080

# At least one model gateway key
SHENSUANYUN_API_KEY=
ZAI_CODING_CN_API_KEY=
DEEPSEEK_API_KEY=

# bda-api-pass
BDA_AUTH_USER=
AUTH_ADMIN_KEY=
BDA_AUTH_BASE_URL=
BDA_API_BASE_URL=

# @wxg-prc-cpg/dsh-weknora
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
